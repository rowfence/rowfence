{
  "name": "rowstile",
  "displayName": "rowstile policy language",
  "description": "For .authz policy files: highlighting (with SQL inside { }), errors while typing, hover, go to definition, references, outline and completion, from the rowstile language server.",
  "version": "0.1.0",
  "publisher": "rowstile",
  "preview": true,
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "git+https://github.com/rowstile/rowstile.git", "directory": "editor" },
  "files": ["extension.js", "language-configuration.json", "syntaxes", "README.md", "LICENSE", "node_modules"],
  "engines": { "vscode": "^1.75.0" },
  "categories": ["Programming Languages", "Linters"],
  "main": "./extension.js",
  "activationEvents": ["onLanguage:authz"],
  "contributes": {
    "languages": [{
      "id": "authz",
      "aliases": ["authz policy", "authz"],
      "extensions": [".authz"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "authz",
      "scopeName": "source.authz",
      "path": "./syntaxes/authz.tmLanguage.json",
      "embeddedLanguages": { "meta.embedded.sql.authz": "sql" }
    }],
    "configuration": {
      "title": "rowstile",
      "properties": {
        "rowstile.command": {
          "type": "array", "items": { "type": "string" },
          "default": ["rowstile", "lsp"],
          "description": "How to start the language server, e.g. [\"python3\", \"/path/to/rowstile/cli/rowstile_cli.py\", \"lsp\"]."
        }
      }
    }
  },
  "scripts": { "package": "vsce package" },
  "dependencies": { "vscode-languageclient": "^9.0.1" },
  "devDependencies": { "@types/vscode": "~1.75.0", "@vscode/vsce": "^3.2.1" }
}
