-- A deny that inherits (docs/cookbook/deny-that-inherits.md): a hidden page hides everything below it, even
-- from people who may read higher up.
app role app_user

type user = app.users

type page = app.pages
  parent : page = parent_id
  reader : user = app.page_readers(page_id -> user_id)

  can hidden = {hidden} or parent.hidden
  can read   = (reader or parent.read) and not hidden

rules app.pages
  select : read
