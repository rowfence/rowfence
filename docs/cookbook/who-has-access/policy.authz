-- Who has access (docs/cookbook/who-has-access.md): the policy is the one of any shared document; the page is
-- about the questions the database then answers.
app role app_user

type user = app.users

type document = app.documents
  owner  : user = owner_id
  viewer : user shared by share

  can share = owner
  can view  = share or viewer

rules app.documents
  select          : view
  insert          : owner
  update          : share
  update owner_id : nobody
  delete          : share
